# ============================================================
# NexusTrade — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Deriv API ----
# Get your token from: https://app.deriv.com/account/api-token
# Required scopes: Read, Trade, Payments, Admin
DERIV_API_TOKEN=your_api_token_here
DERIV_APP_ID=1089

# Set to "false" to switch to live trading (USE WITH CAUTION)
DEMO_MODE=true

# ---- Notifications (optional) ----
# Create a bot at https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord webhook URL (Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK=

# ---- Database (optional, defaults to SQLite) ----
# Uncomment and set for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/nexustrade

# ---- Server ----
HOST=0.0.0.0
PORT=8000
